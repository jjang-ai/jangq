# OpenAI-compatible server via vmlx-engine
# pip install "jang[mlx]" vmlx-engine openai httpx

vmlx-engine serve {{ model_path }} \
  --served-model-name {{ model_name }} \
  --host 127.0.0.1 \
  --port 8000 \
  --continuous-batching \
  --use-paged-cache{% if has_tool_parser %} \
  --enable-auto-tool-choice \
  --tool-call-parser {{ tool_parser or "auto" }}{% endif %} &

curl http://127.0.0.1:8000/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '{
    "model": "{{ model_name }}",
    "messages": [{"role": "user", "content": "Hello"}]{% if has_tool_parser %},
    "tools": [{"type": "function", "function": {"name": "get_weather"}}]{% endif %}
  }'
