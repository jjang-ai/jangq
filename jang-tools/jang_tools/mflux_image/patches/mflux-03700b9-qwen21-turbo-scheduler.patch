diff --git a/src/mflux/models/qwen21/model/qwen21_scheduler.py b/src/mflux/models/qwen21/model/qwen21_scheduler.py
index 4c63ba1..d7b5430 100644
--- a/src/mflux/models/qwen21/model/qwen21_scheduler.py
+++ b/src/mflux/models/qwen21/model/qwen21_scheduler.py
@@ -71,3 +71,44 @@ class ViggleTurboScheduler(BaseScheduler):
 
 register_contrib(ViggleTurboScheduler, "viggle_turbo")
 register_contrib(ViggleTurboScheduler, "ViggleTurboScheduler")
+
+
+class Qwen21TurboScheduler(BaseScheduler):
+    """Fixed sigma grid of Qwen/Qwen-Image-2.1-Turbo (model_index.json ``sample_sigmas``).
+
+    The Turbo checkpoint is an 8-step distill of Qwen-Image-2.1. Diffusers (PR #14950) passes the
+    pipeline-configured grid to FlowMatchEulerDiscreteScheduler.set_timesteps(sigmas=...); the
+    Turbo scheduler config has shift=1.0, use_dynamic_shifting=false and shift_terminal=null, so the
+    nodes are used unchanged (no resolution shift, no terminal rescale) and a terminal 0 is appended.
+    step() is the same first-order Euler update LinearScheduler uses.
+    """
+
+    SIGMA_NODES = (1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568)
+
+    def __init__(self, config):
+        self.config = config
+        steps = config.num_inference_steps
+        if steps != len(self.SIGMA_NODES):
+            raise ValueError(
+                f"the qwen21_turbo scheduler samples Qwen-Image-2.1-Turbo on its {len(self.SIGMA_NODES)} "
+                f"distilled sigma nodes, but num_inference_steps is {steps}. Use --steps {len(self.SIGMA_NODES)}."
+            )
+        nodes = mx.array(list(self.SIGMA_NODES), dtype=mx.float32)
+        self._sigmas = mx.concatenate([nodes, mx.zeros(1, dtype=mx.float32)])
+        self._timesteps = mx.arange(steps, dtype=mx.float32)
+
+    @property
+    def sigmas(self) -> mx.array:
+        return self._sigmas
+
+    @property
+    def timesteps(self) -> mx.array:
+        return self._timesteps
+
+    def step(self, noise: mx.array, timestep: int, latents: mx.array, **kwargs) -> mx.array:
+        dt = (self._sigmas[timestep + 1] - self._sigmas[timestep]).astype(latents.dtype)
+        return latents + noise.astype(latents.dtype) * dt
+
+
+register_contrib(Qwen21TurboScheduler, "qwen21_turbo")
+register_contrib(Qwen21TurboScheduler, "Qwen21TurboScheduler")
